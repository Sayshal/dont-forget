<div class="reminder-container">
  {{#if hasReminders}}
    <div class="reminder-table-container">
      <table class="reminder-table">
        <thead>
          <tr>
            <th class="col-status" data-tooltip="{{localize 'DONT-FORGET.table-headers.status-tooltip'}}">
              {{localize 'DONT-FORGET.table-headers.status'}}
            </th>
            <th class="col-reminder" data-tooltip="{{localize 'DONT-FORGET.table-headers.reminder-tooltip'}}">
              {{localize 'DONT-FORGET.table-headers.reminder'}}
            </th>
            {{#if isGM}}
              <th class="col-creator" data-tooltip="{{localize 'DONT-FORGET.table-headers.creator-tooltip'}}">
                {{localize 'DONT-FORGET.table-headers.creator'}}
              </th>
            {{/if}}
            <th class="col-created" data-tooltip="{{localize 'DONT-FORGET.table-headers.created-tooltip'}}">
              {{localize 'DONT-FORGET.table-headers.created'}}
            </th>
            <th class="col-actions" data-tooltip="{{localize 'DONT-FORGET.table-headers.actions-tooltip'}}">
              {{localize 'DONT-FORGET.table-headers.actions'}}
            </th>
          </tr>
        </thead>
        <tbody>
          {{#each reminders}}
            <tr class="reminder-row {{#if completed}}completed{{/if}}" data-reminder-id="{{id}}">
              <td class="col-status">
                <input type="checkbox" class="reminder-checkbox" name="{{id}}.isDone" {{#if isDone}}checked{{/if}}
                  data-dtype="Boolean" data-tooltip="{{localize 'DONT-FORGET.mark-done'}}">
              </td>
              <td class="col-reminder">
                <span class="reminder-text {{#if completed}}completed{{/if}}">{{label}}</span>
              </td>
              {{#if ../isGM}}
                <td class="col-creator">
                  <span class="creator-name">{{creatorName}}</span>
                </td>
              {{/if}}
              <td class="col-created">
                <span class="created-time">{{createdTime}}</span>
              </td>
              <td class="col-actions">
                <div class="reminder-actions">
                  <button type="button" data-action="edit" class="reminder-edit"
                    data-tooltip="{{localize 'DONT-FORGET.edit-reminder'}}">
                    <i class="fas fa-edit"></i>
                  </button>
                  <button type="button" data-action="delete" class="reminder-delete"
                    data-tooltip="{{localize 'DONT-FORGET.delete-reminder'}}">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <div class="reminder-empty">
      <p>{{localize 'DONT-FORGET.no-reminders'}}</p>
    </div>
  {{/if}}

  <div class="reminder-footer">
    <button type="button" data-action="delete-completed" class="reminder-delete-completed"
      data-tooltip="{{localize 'DONT-FORGET.delete-completed-tooltip'}}">
      <i class="fas fa-trash"></i> {{localize 'DONT-FORGET.delete-completed'}}
    </button>

    <button type="button" data-action="create" class="reminder-create"
      data-tooltip="{{localize 'DONT-FORGET.add-reminder-tooltip'}}">
      <i class="fas fa-plus"></i> {{localize 'DONT-FORGET.add-reminder'}}
    </button>
  </div>
</div>
