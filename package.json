  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^8.52.0",
    "globals": "^15.10.0",
    "prettier-eslint": "^16.1.2",
    "prettier": "^3.1.0",
    "rollup": "^4.59.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2"
  }
